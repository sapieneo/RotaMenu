# Supabase (proje ayarlarından)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (menü OCR/çıkarımı ve Runware prompt üretimi)
OPENAI_API_KEY=
OPENAI_MENU_MODEL=gpt-5.6-terra
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Runware (ürün görseli üretimi — A7/A8)
RUNWARE_API_KEY=
# İsteğe bağlı: AIR model kimliği (varsayılan FLUX.1 schnell) ve adım sayısı
# RUNWARE_MODEL=runware:100@1
# RUNWARE_STEPS=4

# Uygulama
NEXT_PUBLIC_APP_URL=http://localhost:3000

# iyzico (Faz C — Pro abonelik / faturalama)
# Sandbox: https://sandbox-api.iyzipay.com  ·  Prod: https://api.iyzipay.com
IYZICO_URI=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# iyzico panelinde oluşturulan Pro abonelik "pricing plan" referans kodu.
# Fiyat ve periyot (aylık/yıllık) bu planda tanımlıdır; kodda tutulmaz.
IYZICO_PRO_PRICING_PLAN_REF=

# Süper-admin kontrol paneli (/admin) — tüm işletmeleri gören tek şifreli
# giriş. Boşsa /admin tamamen kapalı (isAdminPasswordConfigured() false).
# Güçlü, rastgele bir değer kullan; bu string aynı zamanda oturum çerezini
# imzalayan HMAC anahtarıdır.
ADMIN_PASSWORD=

# SMS OTP sağlayıcısı (Faz C, henüz kurulmadı). Boş olduğu sürece
# /studyo/hesap'ta "Telefonu doğrula (bypass)" geliştirme düğmesi aktif kalır.
# SMS_PROVIDER_API_KEY=
